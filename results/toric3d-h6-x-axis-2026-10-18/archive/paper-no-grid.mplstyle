# Compact scientific plots: boxed axes, connected points, no gridlines.
figure.figsize: 7.4, 4.8
figure.dpi: 120
figure.facecolor: white
figure.titlesize: 14
font.family: sans-serif
font.sans-serif: DejaVu Sans
font.size: 11
mathtext.fontset: dejavusans
axes.facecolor: white
axes.edgecolor: 0.25
axes.linewidth: 0.8
axes.grid: False
axes.spines.top: True
axes.spines.right: True
axes.labelsize: 13
axes.titlesize: 13
axes.titleweight: normal
axes.titlepad: 10
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'CC79A7', '7F7F7F', 'D55E00'])
lines.linewidth: 1.5
lines.markersize: 3.8
errorbar.capsize: 2.2
xtick.direction: out
ytick.direction: out
xtick.labelsize: 11
ytick.labelsize: 11
xtick.major.size: 4
ytick.major.size: 4
xtick.major.width: 0.8
ytick.major.width: 0.8
legend.fontsize: 10
legend.frameon: True
legend.framealpha: 1
legend.fancybox: False
legend.edgecolor: 0.8
legend.borderpad: 0.45
savefig.dpi: 300
savefig.facecolor: white
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
